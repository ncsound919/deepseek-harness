{
  "name": "@deepseek-ai/dsh-client-ui-brand-ecosystem",
  "description": "Ecosystem brand for the DeepSeek Harness Web client: dark-blue surfaces, white labels, yellow accents, plus sidebar and hero brand occupants",
  "version": "0.1.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "import": "./lib/client/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
